FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV MAVSDK_VERSION=v2.12.2
ENV MAVSDK_INSTALL_PREFIX=/opt/mavsdk
ARG BUILD_JOBS=2

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        git \
        libcurl4-openssl-dev \
        libeigen3-dev \
        libjsoncpp-dev \
        libprotobuf-dev \
        libssl-dev \
        libtinyxml2-dev \
        pkg-config \
        protobuf-compiler \
        python3 \
        python3-dev \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
RUN git clone --branch ${MAVSDK_VERSION} --depth 1 https://github.com/mavlink/MAVSDK.git \
    && cmake -S MAVSDK -B MAVSDK/build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=${MAVSDK_INSTALL_PREFIX} \
    && cmake --build MAVSDK/build --parallel ${BUILD_JOBS} \
    && cmake --install MAVSDK/build \
    && rm -rf MAVSDK

WORKDIR /app
COPY . .
RUN cmake -S . -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH=${MAVSDK_INSTALL_PREFIX} \
    && cmake --build build --parallel ${BUILD_JOBS}

ENV LD_LIBRARY_PATH=${MAVSDK_INSTALL_PREFIX}/lib

CMD ["/app/build/test_takeoff"]
