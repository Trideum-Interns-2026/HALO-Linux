<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>movement</name>
  <version>0.1.0</version>
  <description>HALO movement service: follows a person at a set distance, keeping them centred in the camera, using offboard velocity commands; scans for them when lost.</description>
  <maintainer email="lisa.huang@ascte.org">Lisa Huang</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>perception_msgs</depend>
  <!-- MAVSDK has no rosdep key; it is installed from the libmavsdk-dev .deb by the Dockerfile and CI -->

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
