#!/usr/bin/env bash
set -Ee -o pipefail

source /opt/ros/jazzy/setup.bash
if [[ -f /opt/ros2_ws/install/setup.bash ]]; then
    source /opt/ros2_ws/install/setup.bash
fi
set -u

if ! command -v setsid >/dev/null 2>&1; then
    echo "setsid is required to manage the simulator process." >&2
    exit 1
fi

sim_pid=
cleanup() {
    local status=$?
    trap - EXIT INT TERM
    if [[ -n "$sim_pid" ]]; then
        kill -TERM -- "-$sim_pid" 2>/dev/null || true
        wait "$sim_pid" 2>/dev/null || true
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

echo "Starting PX4 SITL + Gazebo with model ${PX4_SIM_MODEL:-gz_x500_depth}..."
PX4_SIM_MODEL="${PX4_SIM_MODEL:-gz_x500_depth}" \
    setsid /usr/local/bin/ros2-entrypoint.sh px4-gazebo "$@" &
sim_pid=$!

echo "Waiting for Gazebo to become ready..."
service_ready=false
for _ in {1..60}; do
    if ! kill -0 "$sim_pid" 2>/dev/null; then
        wait "$sim_pid" || true
        echo "PX4/Gazebo exited before the world was ready." >&2
        exit 1
    fi
    if gz service -l 2>/dev/null | grep -Fxq /world/default/create; then
        service_ready=true
        break
    fi
    sleep 1
done
if [[ "$service_ready" != true ]]; then
    echo "Timed out waiting for Gazebo's /world/default/create service." >&2
    exit 1
fi

echo "PX4/Gazebo is ready."
wait "$sim_pid"
