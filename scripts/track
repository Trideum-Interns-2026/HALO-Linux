#!/usr/bin/env bash
set -Ee -o pipefail

source /opt/ros/jazzy/setup.bash
if [[ -f /opt/ros2_ws/install/setup.bash ]]; then
    source /opt/ros2_ws/install/setup.bash
fi
set -u

script_path="$(readlink -f "${BASH_SOURCE[0]}")"
repo_dir="$(cd "$(dirname "$script_path")/.." && pwd)"
build_dir="${repo_dir}/build"

target="${PERCEIVE_TARGET:-sphere}"
case "$target" in
    sphere|marked_person)
        position_topic=/red_sphere_detector/red_sphere/position
        distance_topic=/red_sphere_detector/red_sphere/distance
        ;;
    person)
        position_topic=/person_detector/person/position
        distance_topic=/person_detector/person/distance
        ;;
    *)
        echo "Unsupported PERCEIVE_TARGET '$target' (use sphere, person, or marked_person)." >&2
        exit 2
        ;;
esac

cmake -S "$repo_dir" -B "$build_dir"
cmake --build "$build_dir" --target main

echo "Starting Kalman target tracking and camera-based centering for ${target}."
echo "Press Ctrl+C here to stop tracking and land; fly and perceive remain running."
exec "$build_dir/main" --ros-args \
    -p position_topic:="$position_topic" \
    -p distance_topic:="$distance_topic" \
    "$@"
