<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tracking</name>
  <version>0.1.0</version>
  <description>Estimates a detected person's WGS84 position from camera, drone position and attitude.</description>
  <maintainer email="cohen.hill@ascte.org">Cohen Hill</maintainer>
  <license>Apache-2.0</license>

  <depend>geolocation_msgs</depend>
  <depend>perception_msgs</depend>
  <depend>px4_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tracking_msgs</depend>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
