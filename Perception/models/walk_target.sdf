<?xml version="1.0"?>
<!--
  Invisible point that walking_person (walking_person.sdf) walks toward.
  walk_actor.py moves it with the world's set_pose service; no visual or
  collision, so neither the cameras nor the drone can see or hit it.
-->
<sdf version="1.9">
  <model name="walk_target">
    <static>true</static>
    <link name="link"/>
  </model>
</sdf>
