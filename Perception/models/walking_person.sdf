<?xml version="1.0"?>
<!--
  Animated walking human, driven from the keyboard by walk_actor.py.

  An <actor> (skinned mesh + walk animation from Gazebo Fuel, downloaded and
  cached in ~/.gz/fuel the first time it's spawned, so the first spawn needs
  internet) with Gazebo's built-in FollowActor system: every sim step it
  walks toward the "walk_target" model (walk_target.sdf), turns to face its
  direction of travel, and advances the walk animation in step with the
  distance covered, so the feet don't slide. walk_actor.py moves that
  invisible target around and the actor chases it.

  min_distance: stops this close to the target, mid-stride (FollowActor
  freezes the animation rather than playing an idle). Tiny, so he stops
  practically on the spot and can turn there (see LEAD_M in walk_actor.py,
  which must stay just above it). max_distance: he gives
  up following past this, so it's big enough never to trigger in practice.
  velocity: walking speed, fixed at spawn; walk_actor.py's WALK_MPS must
  match it so the target never runs away from him. animation_x_vel: seconds
  of walk animation per meter walked, = walk.dae's 5.75s cycle / its 1.384m
  of hip travel, so the feet match the ground instead of sliding.

  Spawn position goes in an <actor><pose>, not the create service's pose
  field: FollowActor reads the start position when it loads, before the
  service's pose is applied, and would otherwise walk him offset by the
  spawn point. walk_actor.py writes a copy of this file with the pose in.
  z = 1.0: the actor's origin is its torso (same as Gazebo's own
  follow_actor example world). Yaw 0 only: FollowActor applies the spawn
  rotation twice, so walk_actor.py sets the starting heading by placing
  the target a few cm off in that direction instead.

  Actors have no collision and aren't physics bodies: he walks through
  buildings and doesn't fall, same as the static standing_person. He's
  ~1.75m tall vs. standing_person's 1.9m, so person_detector's distance
  estimate (person_height_m = 1.9) reads ~8% far on him.
-->
<sdf version="1.9">
  <actor name="walking_person">
    <skin>
      <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
      <scale>1.0</scale>
    </skin>
    <animation name="walk">
      <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
      <interpolate_x>true</interpolate_x>
    </animation>
    <plugin filename="gz-sim-follow-actor-system" name="gz::sim::systems::FollowActor">
      <target>walk_target</target>
      <min_distance>0.02</min_distance>
      <max_distance>1000</max_distance>
      <velocity>1.4</velocity>
      <animation>walk</animation>
      <animation_x_vel>4.154</animation_x_vel>
    </plugin>
  </actor>
</sdf>
