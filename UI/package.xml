<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ui</name>
  <version>0.1.0</version>
  <description>HALO UI bridge: translates Geolocation and Tracking positions to JSON and posts them to the ground-station web API over HTTP.</description>
  <maintainer email="cohen.hill@ascte.org">Cohen Hill</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geolocation_msgs</depend>
  <depend>tracking_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
