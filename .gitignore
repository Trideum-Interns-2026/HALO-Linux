# Build artifacts — regenerated by cmake/make, never commit these
build/
**/build/

# colcon build artifacts (Perception ROS 2 package)
install/
log/

# VS Code workspace-local settings (keep .devcontainer/, that's shared config)
.vscode/
!.devcontainer/

# Windows "downloaded from the internet" marker files
*:Zone.Identifier

# Compiled binaries, in case any end up outside a build/ folder
*.o
*.obj
*.exe
*.out

# Python
__pycache__/
*.pyc

# OS clutter
.DS_Store
Thumbs.db

# Per-developer Spark settings (HALO_DEV, Selkies password) — never shared
.env

# TensorRT engines are GPU/driver/TensorRT-version specific — build them on
# the Spark with infra/triton/build_engine.sh, never commit one
infra/triton/model_repository/*/[0-9]*/
*.onnx
*.plan
*.engine
.env
