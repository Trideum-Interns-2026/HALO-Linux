{
  "name": "PX4 SITL Dev Container (NVIDIA Spark)",

  // Spark profile: one container per developer on the headless DGX Spark,
  // reached via Brev + VS Code Remote-SSH. Same base compose file as
  // ../devcontainer.json, but docker-compose.spark.yml replaces the WSLg
  // override with a per-developer project (named from HALO_DEV in .env),
  // bridge networking, CDI GPU access, a Selkies remote desktop, and the
  // shared Triton inference endpoint. See docs/spark/README.md.
  "dockerComposeFile": [
    "../../docker-compose.yml",
    "../../docker-compose.spark.yml",
    "../docker-compose.extend.yml"
  ],
  "service": "px4-sitl",
  "workspaceFolder": "/workspace",
  "overrideCommand": false,

  // Keeps the container running after VS Code disconnects, so you don't
  // lose your dev container between sessions.
  "shutdownAction": "none",

  // Host side, before compose: checks HALO_DEV, builds the base image,
  // creates the shared inference network.
  "initializeCommand": "bash .devcontainer/spark/initialize.sh",

  // Builds Perception + shell aliases (shared script), then the Spark-only
  // display/VirtualGL bits.
  "postCreateCommand": "bash /workspace/.devcontainer/spark/post-create.sh",

  // Xvfb + openbox + coturn + Selkies, every (re)start.
  "postStartCommand": "bash /usr/local/bin/start-desktop.sh",

  // Both go through this developer's own Remote-SSH tunnel; nothing is
  // published on the Spark itself. 8080 is the Selkies page, 3478 is the
  // TURN relay the browser needs for the WebRTC media to follow the same
  // tunnel.
  "forwardPorts": [8080, 3478],
  "portsAttributes": {
    "8080": { "label": "Selkies desktop", "onAutoForward": "openBrowser" },
    "3478": { "label": "Selkies TURN relay", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "ms-python.python",
        "ranch-hand-robotics.rde-ros-2",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "cmake.configureOnOpen": false,
        "ros.distro": "jazzy"
      }
    }
  },

  "remoteUser": "root"
}
