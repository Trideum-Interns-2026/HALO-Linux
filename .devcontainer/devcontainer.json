{
  "name": "PX4 SITL Dev Container",

  // Reuses the same image/build as the normal run setup, plus an override
  // that stops it from auto-launching the sim on start.
  "dockerComposeFile": [
    "../docker-compose.yml",
    "../docker-compose.wsl.yml",
    "docker-compose.extend.yml"
  ],
  "service": "px4-sitl",
  "workspaceFolder": "/workspace",
    "overrideCommand": false,

  // Always forward these, whichever computer opens the container.
  // 8000: ground-station web API and dashboard (GroundstationAPI/).
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Ground-station dashboard", "onAutoForward": "notify" }
  },

  // Keeps the container running after VS Code disconnects, so you don't
  // lose your dev container between sessions.
  "shutdownAction": "none",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "ms-python.python",
        "ranch-hand-robotics.rde-ros-2",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "cmake.configureOnOpen": false,
        "ros.distro": "jazzy"
      }
    }
  },

  // Runs once after the container is created — builds the ROS service
  // packages and sets up shell aliases, without launching Gazebo.
  "postCreateCommand": "bash /workspace/.devcontainer/post-create.sh",

  "remoteUser": "root"
}