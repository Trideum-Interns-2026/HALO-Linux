<?xml version="1.0" encoding="UTF-8"?>
<!-- Basic city: low-poly blocks (about 3.7 m tall) on black roads, dark sky; 500 m x 500 m
     Built from two sources: PX4's default world supplies the physics, gravity, magnetic field and
     GPS origin (so SITL works), and JdeRobot's RoboticsInfrastructure (humble-devel, scene
     basic_city.world) supplies the look (sky, lights, ground plane) and the large_basic_city model. Use the scene's
     own ground and sky: the city only reads as a city against them (the black roads ARE the
     black ground). Meshes are found through GZ_SIM_RESOURCE_PATH, see Worlds/city/README.md.
     The world name must equal this file's name: PX4 loads $PX4_GZ_WORLDS/$PX4_GZ_WORLD.sdf and
     talks to /world/<name>/... -->
<sdf version="1.9">
  <world name="city_basic">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic" />
    <scene>
      <background>0.008 0.008 0.012</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>0</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>1 1 1 1</specular>
      <direction>0 0 -1</direction>
      <visualize>false</visualize>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0.01 0.01 0.01 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
    <include>
      <uri>model://large_basic_city</uri>
      <pose>0 0 -0.5 0 0 0</pose>
    </include>
  </world>
</sdf>
